# 企业微信智能机器人长连接配置（必填）
WECOM_BOT_ID=
WECOM_BOT_SECRET=

# 工作时间配置
WORK_START_TIME=09:00
WORK_END_TIME=18:00
WORK_DAYS=1,2,3,4,5

# 业务参数
MIN_INTERVAL_SECONDS=15
MAX_INTERVAL_SECONDS=30
COOLDOWN_MINUTES=120

# 连续发送失败多少次后从目标群聊列表中移除，默认 3
MAX_SEND_FAILURES=3

# 每日保底触发窗口（分钟）：工作结束前该时长内，若仍有群聊当天未触发则强制触发，默认 30
FORCE_TRIGGER_WINDOW_MINUTES=30

# 服务启动时立即对所有目标群聊触发一轮喊话：true 开启，默认 false
# 开启后无视工作时间与随机概率，便于部署后立即验证效果
TRIGGER_ON_START=false

# 触发后向群聊发送的喊话内容，默认 妈妈
SCREAM_CONTENT=

# 触发后优先发送的语音文件绝对路径（如 /path/to/scream.amr）；
# 企业微信语音素材仅支持 amr 格式且不超过 2MB，启动时会校验后缀与体积；
# 文件缺失、读取、上传或发送失败时回退为发送 SCREAM_CONTENT 文字，
# 连续失败 3 次后暂停语音 1 小时；留空则始终发送文字
SCREAM_VOICE_FILE=

# 停止指令关键词：文本剥离开头的 @提及 后包含该词即停止，默认 牛来
# 关键词中的空白会被忽略（与消息内容的空白压缩规则一致）
STOP_KEYWORD=

# 完成后回复：停止指令生效后回复该消息
# FINISH_REPLY_TYPE 支持 text（默认）或 image
# 文本内容由 FINISH_REPLY_TEXT 指定，默认发送 emoji 🐮
FINISH_REPLY_TYPE=text
FINISH_REPLY_TEXT=
# 图片按地址索引，支持 http(s) URL 或本地文件路径；FINISH_REPLY_TYPE=image 时必填
FINISH_REPLY_IMAGE_URL=

# 主动发送目标会话 ID（群聊或单聊），多个 ID 用逗号分隔
# 运行期间自动发现的新群聊会增量加入，重复 ID 不会重复添加
TARGET_CHAT_ID=

# 日志级别：debug、info、warn、error
LOG_LEVEL=info
