# 企业微信智能机器人长连接配置（必填）
WECOM_BOT_ID=
WECOM_BOT_SECRET=

# 工作时间配置
WORK_START_TIME=09:00
WORK_END_TIME=18:00
WORK_DAYS=1,2,3,4,5

# 业务参数
MIN_INTERVAL_SECONDS=15
MAX_INTERVAL_SECONDS=30
COOLDOWN_MINUTES=120

# 连续发送失败多少次后从目标群聊列表中移除，默认 3
MAX_SEND_FAILURES=3

# 主动发送目标会话 ID（群聊或单聊）
# 留空时自动从收到的群消息回调中收集目标群聊
TARGET_CHAT_ID=

# 日志级别：debug、info、warn、error
LOG_LEVEL=info
